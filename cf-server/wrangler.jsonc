{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iskey-server",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-29",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PUBLIC_KEYS",
      "id": "your-kv-namespace-id",
      "preview_id": "your-preview-kv-namespace-id"
    }
  ],
  "vars": {
    "API_VERSION": "v1",
    "ALLOWED_ORIGINS": "*"
  }
}
