# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 数据库配置（SQLite）
DB_DRIVER=sqlite
DB_DSN=./iskey.db

# 或使用 PostgreSQL
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=secret dbname=iskey port=5432 sslmode=disable

# 安全配置（为空时禁止写操作）
ADMIN_TOKEN=your-super-secure-admin-token-here
ALLOWED_ORIGINS=*

# 日志配置
LOG_LEVEL=info
