[Unit]
Description=SSH 密钥管理服务器
After=network.target

[Service]
Type=simple
User=iskey-server
Group=iskey-server
WorkingDirectory=/opt/iskey-server
ExecStart=/opt/iskey-server/iskey-server server -f
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iskey-server

# 密钥放在环境文件中，不要写在本 unit 里；文件权限应为 0600
EnvironmentFile=-/etc/iskey-server.env
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080
Environment=DB_DRIVER=sqlite
Environment=DB_PATH=/opt/iskey-server/iskey.db
Environment=ALLOWED_ORIGINS=*
Environment=LOG_LEVEL=info

# 安全限制
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iskey-server

[Install]
WantedBy=multi-user.target
